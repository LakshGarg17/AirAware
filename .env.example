# ==============================================================================
# AirAware Environment Configuration (All variables have safe fallbacks)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Frontend API URL configuration
# For local development with Vite proxy, can be empty or http://127.0.0.1:8000
# For production (Vercel): Set to deployed Render service (e.g. https://airaware-backend.onrender.com)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Open-Meteo Integration (No API key required)
CACHE_TTL_SECONDS=900

# Gemini AI Integration (Optional)
# If GEMINI_API_KEY is omitted or AI_ENABLED=false, app automatically falls back to deterministic rule engine
AI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=2048

# Protection & Safety Safeguards
RATE_LIMIT_PER_MINUTE=20
CHAT_MAX_MESSAGE_CHARS=500
CHAT_MAX_HISTORY_TURNS=8
